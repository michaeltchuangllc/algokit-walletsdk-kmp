<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Seed Vault Permissions -->
    <uses-permission android:name="com.solanamobile.seedvault.ACCESS_SEED_VAULT" />
    <uses-permission android:name="com.solanamobile.seedvault.ACCESS_SEED_VAULT_PRIVILEGED" />

    <!-- Package visibility for Android 11+ to query the wallet service app -->
    <queries>
        <package android:name="com.michaeltchuang.walletsdk.demo" />
        <package android:name="com.solanamobile.seedvaultimpl" />
        <intent>
            <action android:name="com.michaeltchuang.walletsdk.service.WALLET_SERVICE" />
        </intent>
    </queries>

    <application
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.Material3.DayNight">

        <!-- Permission Gauntlet Activity - requests Seed Vault permission at startup -->
        <activity
            android:name=".ui.PermissionGauntletActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Main Activity - requires Seed Vault permission -->
        <activity
            android:name=".ui.MainActivity"
            android:exported="true" />

    </application>

</manifest>
