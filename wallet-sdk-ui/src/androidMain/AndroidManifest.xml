<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Network and connectivity -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Camera for QR code scanning -->
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.camera.autofocus"
        android:required="false" />
    <uses-permission
        android:name="android.permission.CAMERA"
        android:required="false" />
    <uses-permission
        android:name="android.permission.FLASHLIGHT"
        android:required="false" />

    <!-- Foreground service permissions for Liquid Auth SignalService -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <!-- Biometric authentication for passkeys -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <!-- Notifications for SignalService and passkey operations -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application>
        <activity
            android:name=".passkeys.PasskeyActivity"
            android:enabled="true"
            android:exported="true"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="com.algorand.android.credentials.CREATE_PASSKEY" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="com.algorand.android.credentials.GET_PASSKEY" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <service
            android:name=".passkeys.PasskeyProviderService"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.BIND_CREDENTIAL_PROVIDER_SERVICE">
            <intent-filter>
                <action android:name="android.service.credentials.CredentialProviderService" />
            </intent-filter>
            <!-- Note: Apps using this library must provide their own @xml/provider resource -->
        </service>

        <!-- SignalService for Liquid Auth WebRTC/WebSocket connections -->
        <service
            android:name="com.michaeltchuang.walletsdk.core.liquidAuth.auth.connect.SignalService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <activity android:name=".liquidAuth.AnswerActivity"
            android:theme="@style/Theme.AppCompat.NoActionBar"
            />

    </application>
</manifest>
